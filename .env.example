# Server only. Never expose this as EXPO_PUBLIC_HF_TOKEN.
HF_TOKEN=
MODEL=Qwen/Qwen3-4B-Instruct-2507

# Required for iOS and Android: an absolute HTTPS URL for the deployed gateway.
EXPO_PUBLIC_GENERATION_ENDPOINT=

# Use the Test Store key only in development or preview builds, with the
# explicit opt-in below. Platform keys win whenever the flag is not true.
EXPO_PUBLIC_REVENUECAT_USE_TEST_STORE=false
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=

# Production builds should omit the Test Store key and use platform keys.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Optional native retention track. This is the public OneSignal App ID, not an
# App API key. Push still requires a development build and configured FCM/APNs.
EXPO_PUBLIC_ONESIGNAL_APP_ID=

# Optional native growth analytics. This public App ID enables Layers app-open,
# lifecycle and product-event tracking. The app never requests ATT on launch.
EXPO_PUBLIC_LAYERS_APP_ID=
