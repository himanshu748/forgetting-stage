{
  "name": "the-forgetting-stage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "gateway:local": "node --env-file-if-exists=.env --experimental-strip-types src/live/dev-server.ts",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "spike": "node --env-file-if-exists=../forgetting-stage-notes/.env --experimental-strip-types src/spikes/confabulation.ts",
    "play": "node --env-file-if-exists=../forgetting-stage-notes/.env --experimental-strip-types src/spikes/full-play.ts",
    "experiment": "node --env-file-if-exists=../forgetting-stage-notes/.env --experimental-strip-types src/experiments/run.ts"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "@layers/expo": "3.2.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.15",
    "expo-clipboard": "~57.0.1",
    "expo-dev-client": "~57.0.14",
    "expo-linking": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-tracking-transparency": "~57.0.1",
    "onesignal-expo-plugin": "2.7.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-onesignal": "5.5.6",
    "react-native-purchases": "^10.6.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
