{
  "name": "the-forgetting-stage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "spike": "node --env-file-if-exists=../forgetting-stage-notes/.env --experimental-strip-types src/spikes/confabulation.ts",
    "play": "node --env-file-if-exists=../forgetting-stage-notes/.env --experimental-strip-types src/spikes/full-play.ts",
    "experiment": "node --env-file-if-exists=../forgetting-stage-notes/.env --experimental-strip-types src/experiments/run.ts"
  },
  "dependencies": {
    "expo": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
